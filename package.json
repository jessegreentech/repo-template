{
  "name": "repo-template",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "test": "node --experimental-strip-types --experimental-test-coverage --test --test-coverage-lines=80",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "visual": "playwright test --config visual/playwright.config.ts layout.spec.ts baseline.spec.ts",
    "visual:baseline": "VISUAL_BASELINE=1 playwright test --config visual/playwright.config.ts baseline.spec.ts --update-snapshots=missing",
    "visual:evidence": "playwright test --config visual/playwright.config.ts evidence.spec.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
