{
  "name": "Gitflow branch names",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Gitflow branch names",
        "negate": false,
        "operator": "regex",
        "pattern": "^(main|develop|feature/[a-z0-9]+(-[a-z0-9]+)*|bugfix/[a-z0-9]+(-[a-z0-9]+)*|release/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|hotfix/[a-z0-9]+(-[a-z0-9]+)*)$"
      }
    }
  ],
  "bypass_actors": []
}
